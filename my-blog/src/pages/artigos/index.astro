---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const artigos = (await getCollection('artigos')).sort(
      (a, b) => b.data.publicadoEm.valueOf() - a.data.publicadoEm.valueOf()
);
---

<Layout title="Artigos" description="Artigos de Matheus Pinheiro.">
      <section class="articles">
              <p class="cmd"><span class="prompt">$</span> ls artigos/</p>
              <ul class="article-list">
                      {artigos.map((artigo) => (
                              <li>
                                      <a href={`/artigos/${artigo.id}`}>{artigo.data.titulo}</a>
                                      <span class="date">{artigo.data.publicadoEm.toLocaleDateString('pt-BR')}</span>
                              </li>
                      ))}
              </ul>
      </section>
</Layout>

<style>
      .articles {
              margin-top: var(--space-6);
              padding-top: var(--space-5);
              border-top: 1px solid var(--color-border);
      }

      .cmd {
              margin: 0 0 var(--space-4);
      }

      .article-list {
              list-style: none;
              margin: 0;
              padding: 0;
              display: flex;
              flex-direction: column;
              gap: var(--space-3);
      }

      .article-list li {
              display: flex;
              flex-wrap: wrap;
              justify-content: space-between;
              gap: var(--space-2);
      }

      .article-list a {
              color: var(--color-accent);
              text-decoration: none;
      }

      .article-list a:hover {
              color: var(--color-highlight);
      }

      .date {
              color: var(--color-text-muted);
              font-size: 0.85rem;
      }
</style>