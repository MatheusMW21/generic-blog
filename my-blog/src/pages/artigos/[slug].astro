---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
      const artigos = await getCollection('artigos');
      return artigos.map((artigo) => ({
              params: { slug: artigo.id },
              props: { artigo },
      }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);
---

<Layout title={artigo.data.titulo} description={artigo.data.resumo}>
      <article class="article">
              <p class="cmd"><span class="prompt">$</span> cat artigos/{artigo.id}.md</p>
              <h1>{artigo.data.titulo}</h1>
              <p class="meta">{artigo.data.publicadoEm.toLocaleDateString('pt-BR')}</p>
              <div class="content">
                      <Content />
              </div>
              <a class="back" href="/artigos">← voltar</a>
      </article>
</Layout>

<style>
              <a class="back" href="/artigos">← voltar</a>
      </article>
</Layout>

<style>
      .article {
              margin-top: var(--space-6);
              padding-top: var(--space-5);
              border-top: 1px solid var(--color-border);
      }

      .cmd {
              margin: 0 0 var(--space-3);
      }

      .article h1 {
              margin: 0 0 var(--space-1);
              color: var(--color-accent);
              font-size: 1.5rem;
      }

      .meta {
              margin: 0 0 var(--space-4);
              color: var(--color-text-muted);
              font-size: 0.85rem;
      }

      .content {
              margin-bottom: var(--space-4);
              line-height: 1.7;
      }

      .content :global(p) {
              margin: 0 0 var(--space-3);
      }

      .back {
              color: var(--color-text-muted);
      }

      .back:hover {
              color: var(--color-highlight);
      }
</style>