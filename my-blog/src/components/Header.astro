---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { profile } from '../data/profile';
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale === 'en' ? 'en' : 'pt';
const t = useTranslations(lang);
const p = profile[lang];

const navLinks = [
	{ href: getRelativeLocaleUrl(lang, '/'), label: t('nav_home') },
	{ href: getRelativeLocaleUrl(lang, '/projetos'), label: t('nav_projetos') },
].map((link) => {
	const normalize = (path: string) => path.replace(/\/$/, '') || '/';
	return { ...link, active: normalize(Astro.url.pathname) === normalize(link.href) };
});

const otherLang = lang === 'pt' ? 'en' : 'pt';
const basePath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const langToggleHref = getRelativeLocaleUrl(otherLang, basePath);
---

<header>
	<div class="utility-bar">
		<nav aria-label="Navegação principal">
			{navLinks.map((link) => <a href={link.href} class={link.active ? 'active' : undefined}>{link.label}</a>)}
		</nav>
		<div class="external">
			<a href={profile.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
				</svg>
			</a>
			<a href={profile.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
				</svg>
			</a>
			<a class="cv-link" href={lang === 'en' ? '/curriculo-matheus-pinheiro-en-us.pdf' : '/curriculo-matheus-pinheiro.pdf'} target="_blank" rel="noopener noreferrer">
				{t('cv_download_label')}
			</a>
			<div class="controls">
				<button class="theme-toggle" type="button" aria-label={t('theme_toggle_label')}></button>
				<a class="lang-toggle" href={langToggleHref}>
					{lang === 'pt' ? <><strong>pt</strong>/en</> : <>pt/<strong>en</strong></>}
				</a>
			</div>
		</div>
	</div>

	<p class="cmd"><span class="prompt" aria-hidden="true">$</span> <span class="cmd-text">{t('whoami_cmd')}</span></p>
	<div class="hero">
		<img class="avatar" src="/avatar.jpg" alt="Foto de perfil" />
		<div class="identity">
			<h1 class="name">{profile.name}</h1>
			<p class="tagline">{p.role}</p>
		</div>
	</div>
</header>

<style>
	header {
		padding: var(--space-4) var(--space-5);
	}

	.utility-bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--color-border);
		font-size: 0.85rem;
	}

	nav {
		display: flex;
		gap: var(--space-3);
	}

	.utility-bar nav a {
		position: relative;
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 0.15s ease, padding-left 0.15s ease;
	}

	.utility-bar nav a::before {
		content: '>';
		position: absolute;
		left: -1em;
		color: var(--color-highlight);
		opacity: 0;
		transition: opacity 0.15s ease;
	}

	.utility-bar nav a:hover {
		color: var(--color-text);
		padding-left: 1em;
	}

	.utility-bar nav a:hover::before {
		opacity: 1;
	}

	.utility-bar nav a.active {
		color: var(--color-accent);
	}

	.utility-bar nav a.active::before {
		opacity: 1;
	}

	.external {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.external a {
		display: inline-flex;
		color: var(--color-text-muted);
		transition: color 0.15s ease;
	}

	.external a:hover {
		color: var(--color-highlight);
	}

	.cv-link {
		color: var(--color-accent);
		text-decoration: none;
		border: 1px solid var(--color-accent);
		border-radius: 4px;
		padding: var(--space-1) var(--space-2);
		font-size: var(--font-size-meta);
		white-space: nowrap;
	}

	.cv-link:hover {
		color: var(--color-highlight);
		border-color: var(--color-highlight);
	}

	.controls {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-left: var(--space-2);
		padding-left: var(--space-3);
		border-left: 1px solid var(--color-border);
	}

	.theme-toggle,
	.lang-toggle {
		font-family: inherit;
		font-size: inherit;
		background: none;
		border: none;
		color: var(--color-text-muted);
		text-decoration: none;
		cursor: pointer;
		padding: 0;
	}

	.theme-toggle {
		font-size: 2.0rem;
		line-height: 1;
	}

	.theme-toggle::before {
		content: '☀';
	}

	:root[data-theme="light"] .theme-toggle::before {
		content: '☾';
	}

	.theme-toggle:hover,
	.lang-toggle:hover {
		color: var(--color-highlight);
	}

	.lang-toggle strong {
		color: var(--color-text);
	}

	.cmd {
		margin: var(--space-5) 0 var(--space-2);
	}

	.hero {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	.avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--color-accent);
		flex-shrink: 0;
	}

	.name {
		margin: 0;
		font-size: 1.75rem;
		color: var(--color-accent);
	}

	.tagline {
		margin: var(--space-1) 0 0;
		color: var(--color-text-muted);
	}

	.available {
		display: flex;
		align-items: center;
		gap: 6px;
		margin: var(--space-2) 0 0;
		font-size: var(--font-size-meta);
		color: #4ade80;
	}

	.available-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #4ade80;
		flex-shrink: 0;
		animation: pulse-dot 2s ease-in-out infinite;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; transform: scale(1); }
		50%       { opacity: 0.4; transform: scale(0.75); }
	}

	@media (max-width: 640px) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
			text-align: left;
		}
	}
</style>
<script>
	document.addEventListener('astro:page-load', () => {
		const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
		button?.addEventListener('click', () => {
			const root = document.documentElement;
			const next = root.dataset.theme === 'light' ? 'dark' : 'light';
			root.dataset.theme = next;
			localStorage.setItem('theme', next);
		});
	});

	document.addEventListener('astro:page-load', () => {
		if (sessionStorage.getItem('portfolio_visited')) return;
		sessionStorage.setItem('portfolio_visited', '1');

		const el = document.querySelector<HTMLElement>('.cmd-text');
		if (!el) return;

		const text = el.textContent ?? '';
		el.textContent = '';
		let i = 0;

		const type = () => {
			if (i < text.length) {
				el.textContent += text[i++];
				setTimeout(type, 80);
			}
		};
		type();
	});
</script>
