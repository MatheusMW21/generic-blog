---
import { projects } from '../data/projetos';
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale === 'en' ? 'en' : 'pt';
const t = useTranslations(lang);
---

<section class="projects">
      <p class="cmd"><span class="prompt">$</span> {t('projects_cmd')}</p>
      <div class="project-list">
              {projects.map((project) => (
                      <article class="project">
                              <h2>
                                      {project.url ? (
                                              <a href={project.url} target="_blank" rel="noopener noreferrer">{project.title}</a>
                                      ) : (
                                              project.title
                                      )}
                              </h2>
                              {project.stack && (
                                      <p class="stack badge-list">
                                              {project.stack.map((item) => <span class="badge">{item}</span>)}
                                      </p>
                              )}
                              {project.destaques ? (
                                      <ul class="highlights">
                                              {project.destaques[lang].map((item) => <li>{item}</li>)}
                                      </ul>
                              ) : (
                                      <p class="description">{project.description[lang]}</p>
                              )}
                      </article>
              ))}
      </div>
</section>

<style>
      .projects {
              margin-top: var(--space-2);
              padding-top: var(--space-3);
              border-top: 1px solid var(--color-border);
      }

      .cmd {
              margin: 0 0 var(--space-4);
      }

      .project-list {
              display: flex;
              flex-direction: column;
              gap: var(--space-5);
      }

      .project h2 {
              margin: 0 0 var(--space-1);
              font-size: 1.1rem;
              color: var(--color-accent);
      }

      .project h2 a {
              color: inherit;
              text-decoration: none;
      }

      .project h2 a:hover {
              color: var(--color-highlight);
      }

      .stack {
              margin: 0 0 var(--space-2);
      }

      .description {
              margin: 0;
              color: var(--color-text);
      }

      .highlights {
              list-style: none;
              margin: 0;
              padding: 0;
              display: flex;
              flex-direction: column;
              gap: var(--space-1);
              color: var(--color-text);
      }

      .highlights li::before {
              content: '– ';
              color: var(--color-highlight);
      }
</style>