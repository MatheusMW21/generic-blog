---
import { profile } from '../data/profile';
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale === 'en' ? 'en' : 'pt';
const t = useTranslations(lang);
const p = profile[lang];
---

<section class="about">
	<p class="cmd"><span class="prompt">$</span> {t('about_cmd')}</p>
	<p>{p.bio}</p>

	{p.experience.map((job) => (
		<>
			<p class="cmd"><span class="prompt">$</span> {t('experience_cmd_prefix')}{job.empresa}</p>
			<ul class="job-list">
				{job.cargos.map((item) => (
					<li>
						<span class="perm">-rwxr-xr-x</span>
						<span class="period">{item.periodo}</span>
						<span class="role">{item.cargo}</span>
					</li>
				))}
			</ul>
		</>
	))}
</section>

<p class="cmd"><span class="prompt">$</span><span class="cursor"></span></p>

<style>
	.about {
		margin-top: var(--space-6);
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.cmd {
		margin: 0 0 var(--space-3);
	}

	.about p:not(.cmd) {
		margin: 0 0 var(--space-4);
	}

	.job-list {
		list-style: none;
		margin: 0 0 var(--space-4);
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.job-list li {
		display: grid;
		grid-template-columns: auto auto 1fr;
		gap: var(--space-3);
	}

	.perm,
	.period {
		color: var(--color-text-muted);
		font-size: 0.85rem;
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.job-list li {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.perm {
			display: none;
		}
	}
</style>
