---
import { profile } from '../data/profile';
import { skills } from '../data/skills';
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale === 'en' ? 'en' : 'pt';
const t = useTranslations(lang);
const p = profile[lang];

const skillGroups = [
	{ label: t('skills_languages'), items: skills.languages },
	{ label: t('skills_backend'), items: skills.backend },
	{ label: t('skills_frontend'), items: skills.frontend },
	{ label: t('skills_cloud'), items: skills.cloudDevops }
];
---

<section class="about">
      <h2 class="cmd"><span class="prompt" aria-hidden="true">$</span> {t('about_cmd')}</h2>
      <p>{p.bio}</p>

      <h2 class="cmd"><span class="prompt" aria-hidden="true">$</span> {t('skills_cmd')}</h2>
      <ul class="skills-list">
              {skillGroups.map((group) => (
                      <li>
                              <span class="skill-label">{group.label}</span>
                              <span class="skill-items badge-list">
                                        {group.items.map((item) => <span class="badge">{item}</span>)}
                              </span>
                      </li>
              ))}
      </ul>

      <h2 class="cmd"><span class="prompt" aria-hidden="true">$</span> {t('experience_cmd_prefix')}</h2>
      <ul class="job-list">
              {p.experience.map((job) => (
                      <li class="job">
                              <div class="job-head">
                                      <span class="job-title">{job.cargo} · {job.empresa}</span>
                                      <span class="period">{job.periodo}</span>
                              </div>
                              <ul class="job-highlights">
                                      {job.destaques.map((item) => <li>{item}</li>)}
                              </ul>
                      </li>
              ))}
      </ul>

      <h2 class="cmd"><span class="prompt" aria-hidden="true">$</span> {t('contact_cmd')}</h2>
      <p class="contact">
        <a href={`mailto:${profile.social.email}`}>{profile.social.email}</a>
        <button
                class="copy-email"
                type="button"
                data-email={profile.social.email}
                data-copied-label={t('copy_email_copied')}
        >
                {t('copy_email_label')}        
        </button>
      </p>
</section>

<p class="cmd" aria-hidden="true"><span class="prompt">$</span><span class="cursor"></span></p>

<style>
      .about {
              margin-top: var(--space-4);
              padding-top: var(--space-5);
              border-top: 1px solid var(--color-border);
      }

      .cmd {
              margin: 0 0 var(--space-3);
      }

      .about p:not(.cmd) {
              margin: 0 0 var(--space-4);
      }

      .skills-list {
              list-style: none;
              margin: 0 0 var(--space-4);
              padding: 0;
              display: flex;
              flex-direction: column;
              gap: var(--space-1);
      }

      .skills-list li {
              display: grid;
              grid-template-columns: 9em 1fr;
              gap: var(--space-3);
      }

      .skill-label {
              color: var(--color-text-muted);
              font-size: var(--font-size-meta);
      }

      .job-list {
              list-style: none;
              margin: 0 0 var(--space-4);
              padding: 0;
              display: flex;
              flex-direction: column;
              gap: var(--space-4);
      }

      .job-head {
              display: flex;
              flex-direction: column;
              gap: 2px;
              margin-bottom: var(--space-1);
      }

      .job-title {
              color: var(--color-accent);
      }

      .period {
              color: var(--color-text-muted);
              font-size: var(--font-size-meta);
              white-space: nowrap;
      }

      .job-highlights {
              list-style: none;
              margin: 0;
              padding: 0;
              display: flex;
              flex-direction: column;
              gap: var(--space-1);
              color: var(--color-text);
              font-size: 1rem;
      }

      .job-highlights li::before {
              content: '– ';
              color: var(--color-highlight);
      }

      @media (max-width: 640px) {
              .skills-list li {
                      grid-template-columns: 1fr;
                      gap: 0;
              }
      }
      .contact {
              display: flex;
              flex-wrap: wrap;
              align-items: center;
              gap: var(--space-3);
      }

      .contact a {
              color: var(--color-accent);
      }

      .copy-email {
              font-family: inherit;
              font-size: var(--font-size-meta);
              background: none;
              border: 1px solid var(--color-border);
              border-radius: 4px;
              padding: 2px var(--space-2);
              color: var(--color-text-muted);
              cursor: pointer;
      }

      .copy-email:hover {
              color: var(--color-highlight);
              border-color: var(--color-highlight);
      }

</style>

<script>
      const button = document.querySelector<HTMLButtonElement>('.copy-email');
      const defaultLabel = button?.textContent?.trim() ?? '';

      button?.addEventListener('click', async () => {
              const email = button.dataset.email;
              if (!email) return;
              await navigator.clipboard.writeText(email);
              button.textContent = button.dataset.copiedLabel ?? defaultLabel;
              setTimeout(() => {
                      button.textContent = defaultLabel;
              }, 1500);
      });
</script>